# Copy this file to .env and fill in as many providers below as you have -
# .env is gitignored, real keys never get committed. Loaded automatically by
# both the CLI (main.py) and the backend (server/app.py) via python-dotenv.
#
# Fallback: every configured provider (any key present below) is tried in
# turn - Gemini, then OpenAI, then AWS Bedrock - moving to the next one if a
# call errors, has an expired/invalid key, or takes longer than
# LLM_TIMEOUT_SECONDS (default 20s). Set LLM_PROVIDER to try that one FIRST
# before the others; it's a preference, not an exclusive lock. Only
# LLM_PROVIDER=offline (or "none") fully disables model calls, regardless of
# which keys are present - useful for a deterministic, credential-free demo.
# LLM_PROVIDER=openai
# LLM_TIMEOUT_SECONDS=20

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (google-genai SDK) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- AWS Bedrock (Anthropic Claude via boto3) ---
# Use either an AWS profile or explicit access keys - not both.
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: override the default Claude model ID candidates.
BEDROCK_MODEL_ID=
